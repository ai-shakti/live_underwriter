# Live Underwriter — Backend environment configuration
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# --- LLM (Ollama via OpenAI-compatible endpoint) ---
# Base URL of your Ollama server's OpenAI-compatible endpoint.
# For a local Ollama install this is the default.
OLLAMA_BASE_URL=https://www.ollama.com

# API key. For a local Ollama install, any value works (default "ollama").
# If you use a hosted OpenAI-compatible provider, put your real key here.
OLLAMA_API_KEY=a3f71bc7e81e493bb72b761c0783d931.-sayOy3UryyuKOL4Nftm-eod

# Model to use for structured extraction / decisioning.
# qwen2.5 is a strong default for JSON extraction. You can also use
# qwen3, llama3.1, mistral, etc. — whatever you have pulled in Ollama.
OLLAMA_MODEL=qwen2.5

# --- Voice (optional) ---
# faster-whisper model for speech-to-text (small/base for latency,
# turbo/distil-large-v3 for quality).
WHISPER_MODEL=small

# Kokoro TTS voice.
KOKORO_VOICE=af_heart
